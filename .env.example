# =====================================================================
# StudyAI Ghana — Environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ---- Telegram Bot ---------------------------------------------------
# Get a token from @BotFather
TELEGRAM_BOT_TOKEN=
# polling (local dev) | webhook (production)
BOT_MODE=polling
# Required when BOT_MODE=webhook, e.g. https://your-domain.example/webhook
WEBHOOK_URL=
# Random secret used to validate webhook requests (optional, recommended)
WEBHOOK_SECRET=

# ---- Database ---------------------------------------------------------
# PostgreSQL is the production target:
DATABASE_URL=postgresql+asyncpg://studyai:studyai@localhost:5432/studyai
# No-install fallback for quick local dev (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./studyai.db

# ---- Cache / Rate limiting (optional locally) --------------------------
# If empty, an in-process rate limiter is used (fine for local dev).
REDIS_URL=

# ---- AI Provider -------------------------------------------------------
# Providers: openai | anthropic | gemini | openrouter
AI_PROVIDER=openai
AI_API_KEY=

# Model routing: a cheap/fast model for simple tasks, a stronger one for
# heavy tasks (documents, exam analysis). Names depend on the provider.
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_STRONG=gpt-4o
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.4
AI_REQUEST_TIMEOUT=90

# ---- Admin ---------------------------------------------------------------
# Comma-separated Telegram numeric IDs allowed to use admin commands
ADMIN_TELEGRAM_IDS=
# Public bot username used for referral links
BOT_USERNAME=StudyAIGhanaBot

# ---- Free plan limits ---------------------------------------------------
FREE_AI_DAILY_LIMIT=20
FREE_QUIZ_DAILY_LIMIT=3
FREE_QUIZ_MAX_QUESTIONS=10
FREE_EXAMS_DAILY_LIMIT=1
FREE_MAX_DOCUMENT_PAGES=30

# ---- Premium plan limits -------------------------------------------------
PREMIUM_AI_DAILY_LIMIT=200
PREMIUM_QUIZ_DAILY_LIMIT=100
PREMIUM_EXAMS_DAILY_LIMIT=20
PREMIUM_MAX_DOCUMENT_PAGES=400

# ---- Abuse / rate limiting ------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_HOUR=10

# ---- Referral rewards (admin-configurable) --------------------------------
# Invite N friends -> M days of Premium
REFERRAL_REWARD_3_DAYS=1
REFERRAL_REWARD_10_DAYS=7

# ---- Payments (reserved for Phase 3; do NOT hard-code credentials) --------
PAYMENT_PROVIDER=telegram_stars
PAYMENT_PROVIDER_TOKEN=

# ---- Misc ---------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
